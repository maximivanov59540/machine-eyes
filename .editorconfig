# UTF-8 without BOM, LF, spaces - for every file unless a section below says otherwise.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,mjs,json}]
indent_size = 2

# Unity writes .meta files itself: two-space YAML, a trailing space after empty keys, and no final newline in
# the .meta of a script. An editor must not "fix" them, or Unity rewrites them on the next import.
[*.meta]
indent_size = 2
insert_final_newline = unset
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false
